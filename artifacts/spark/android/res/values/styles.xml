<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform Material theme so the APK needs no support libraries. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- API 35 forces edge-to-edge and ignores these, so the bars show the
             window background; MainActivity insets the WebView to match. -->
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
